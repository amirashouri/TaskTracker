# Template for local and self-hosted configuration.
#
#   cp .env.example .env
#
# .env is git-ignored. Never commit real secrets; keep them on the host or in
# your CI/CD secret store. Generate a signing secret with:
#
#   openssl rand -hex 32

# --- Server ---
SERVER_PORT=8080
# One of debug, info, warn, error. The server refuses to start on anything else.
LOG_LEVEL=info

# --- Database ---
# Postgres: postgres://user:password@host:5432/tasktracker
# SQLite:   sqlite:///data/tasktracker.db  (parent directory must exist)
DATABASE_URL=sqlite:///data/tasktracker.db

# --- Auth (required) ---
# At least 32 bytes. The server refuses to start without it.
JWT_SECRET=
# Access tokens are short-lived and stateless. Refresh tokens are rotated on
# every use and revoked on sign-out, so the refresh TTL is how long a session can
# stay idle and still be resumed: 720h is 30 days, the default.
JWT_ACCESS_TTL=1h
JWT_REFRESH_TTL=720h

# --- CORS ---
# Comma-separated browser origins. Mobile clients do not send Origin.
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# --- Sign-in rate limiting ---
# Per-IP and per-email attempt limit inside the window; the endpoint answers
# 429 with Retry-After once it is reached. Set SIGNIN_MAX_ATTEMPTS=0 to disable.
# The limiter is in-process and per-instance: running several replicas
# multiplies the effective limit.
SIGNIN_MAX_ATTEMPTS=10
SIGNIN_WINDOW=15m

# --- Change feed retention ---
# How long sync_log rows are kept. Rows older than this are pruned hourly; a
# client whose cursor is older than what survived is told to resync. 0 keeps
# the feed forever (the database then grows without bound).
SYNC_LOG_RETENTION=720h
