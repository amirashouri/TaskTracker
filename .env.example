# Template for local and self-hosted configuration.
#
#   cp .env.example .env
#
# .env is git-ignored. Never commit real secrets; keep them on the host or in
# your CI/CD secret store. Generate a signing secret with:
#
#   openssl rand -hex 32

# --- Server ---
SERVER_PORT=8080
LOG_LEVEL=info

# --- Database ---
# Postgres: postgres://user:password@host:5432/tasktracker
# SQLite:   sqlite:///data/tasktracker.db  (parent directory must exist)
DATABASE_URL=sqlite:///data/tasktracker.db

# --- Auth (required) ---
# At least 32 bytes. The server refuses to start without it.
JWT_SECRET=
JWT_ACCESS_TTL=1h
JWT_REFRESH_TTL=720h

# --- CORS ---
# Comma-separated browser origins. Mobile clients do not send Origin.
CORS_ORIGINS=http://localhost:3000,http://localhost:8080
