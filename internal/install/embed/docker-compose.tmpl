# Rendered by tt from the embedded template. Re-run `tt install` to repair;
# do not edit this file by hand, the next install overwrites it.
services:
{{ if .Postgres }}
  postgres:
    image: postgres:16-alpine
    environment:
      POSTGRES_USER: tasktracker
      POSTGRES_PASSWORD: "{{ .DatabasePassword }}"
      POSTGRES_DB: tasktracker
    volumes:
      - tasktracker-pg-data:/var/lib/postgresql/data
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U tasktracker"]
      interval: 5s
      timeout: 5s
      retries: 5
    restart: unless-stopped
{{ end }}
  server:
    image: "tasktracker-server:{{ .ImageTag }}"
    environment:
      SERVER_BIND: "0.0.0.0"
      SERVER_PORT: "8080"
      DATABASE_URL: "{{ .DatabaseURL }}"
      JWT_SECRET: "{{ .JWTSecret }}"
      LOG_LEVEL: "info"
{{ if .TrustedProxies }}
      TRUSTED_PROXIES: "{{ .TrustedProxies }}"
{{ end }}
    ports:
      - "{{ .PublishHost }}:{{ .ServerPort }}:8080"
{{ if .Sqlite }}
    volumes:
      - tasktracker-data:/data
{{ end }}
{{ if .Postgres }}
    depends_on:
      postgres:
        condition: service_healthy
{{ end }}
    healthcheck:
      test: ["CMD-SHELL", "wget -qO- http://localhost:8080/readyz >/dev/null || exit 1"]
      interval: 10s
      timeout: 3s
      retries: 3
      start_period: 5s
    restart: unless-stopped
{{ if eq .Provider "cloudflare" }}
  cloudflared:
    image: cloudflare/cloudflared:latest
    command: tunnel --no-autoupdate run --token {{ .CloudflareTunnelToken }}
    environment:
      TUNNEL_TOKEN: "{{ .CloudflareTunnelToken }}"
    depends_on:
      - server
    restart: unless-stopped
{{ end }}

volumes:
{{ if .Sqlite }}
  tasktracker-data:
{{ end }}
{{ if .Postgres }}
  tasktracker-pg-data:
{{ end }}
